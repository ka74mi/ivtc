{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "Asia/Tokyo",
  "schedule": ["* 0-5 * * 1"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "labels": ["security"]
  },
  "automerge": false,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true
  },
  "constraints": {
    "ghActionsLock": "v0.5.1"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "gh-actions-lock (GitHub CLI 拡張)のバージョン。CI の GH_ACTIONS_LOCK_VERSION と constraints.ghActionsLock を同時に更新する",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^renovate\\.json$/"
      ],
      "matchStrings": [
        "GH_ACTIONS_LOCK_VERSION:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "\"ghActionsLock\":\\s*\"(?<currentValue>v\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "github/gh-actions-lock",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
 ]
  // プロジェクト固有のルール
  // "packageRules": [
  //   {
  //     "matchManagers": ["dockerfile"],
  //     "matchUpdateTypes": ["minor", "patch"],
  //     "automerge": true
  //   }
  // ]
}
